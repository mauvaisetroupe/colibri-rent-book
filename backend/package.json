{
  "name": "colibri-rent-book-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait test-db",
    "db:down": "docker compose -f docker-compose.dev.yml --profile migrations down",
    "db:local": "docker compose -f docker-compose.dev.yml up -d --wait dev-db adminer && docker compose -f docker-compose.dev.yml run --rm --build dev-migrations",
    "db:local:stop": "docker compose -f docker-compose.dev.yml stop dev-db adminer",
    "db:local:reset": "node scripts/reset-dev-db.mjs",
    "test:local": "TEST_DATABASE_URL=postgres://postgres:test@localhost:55442/colibri_test npm test",
    "lien": "tsx --env-file=.env.local src/cli/lien.ts",
    "jeton": "tsx --env-file=.env.local src/cli/jeton.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^9.3.0",
    "@simplewebauthn/server": "^14.0.3",
    "big.js": "^7.0.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.3",
    "pdf-lib": "1.17.1",
    "pdfmake": "0.3.12",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/big.js": "^7.0.0",
    "@types/node": "^26.4.1",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}

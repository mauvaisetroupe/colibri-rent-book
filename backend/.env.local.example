# Development: PostgreSQL in Docker (npm run db:local), used by npm run dev.
# Copy to .env.local. Development only: the password is not a secret.
DATABASE_HOST=localhost
DATABASE_PORT=55443
DATABASE_NAME=colibri
DATABASE_USER=colibri
DATABASE_PASSWORD=dev

HOST=127.0.0.1
PORT=3000

# Archived invoice PDFs (default: backend/storage/pdf)
# STORAGE_DIR=

# Authentication by passkey (ADR 0020): the address the browser opens (Vite). Without it, no authentication.
COLIBRI_ORIGIN=http://localhost:5173

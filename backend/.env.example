# Copy to .env (gitignored): the API outside Docker against any PostgreSQL. Without DATABASE_PASSWORD, pg reads
# ~/.pgpass. In a container, the composition gives these variables.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=colibri
DATABASE_USER=colibri
# DATABASE_PASSWORD=

HOST=127.0.0.1
PORT=3000

# Archived invoice PDFs (default: backend/storage/pdf)
# STORAGE_DIR=

# Authentication by passkey (ADR 0020): the address of the application as the browser opens it (required in
# production: the API refuses to start without it)
# COLIBRI_ORIGIN=https://colibri.example.org
